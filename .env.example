# --- Alarm API (simulator) ---
ALARM_API_BASE_URL=http://127.0.0.1:8000
ALARM_API_TOKEN=demo-token

# --- RAG ---
DOCUMENT_PATH=rag/documents
VECTOR_STORE_PATH=data/chroma_db
RAG_MAX_DISTANCE=1.2
# sentence-transformers (default) or hash (tests/CI only)
RAG_EMBEDDING_BACKEND=sentence-transformers

# --- LLM ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
# OLLAMA_HOST=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=180
LLM_NUM_PREDICT=300
LLM_NUM_CTX=3072

# --- MCP / orchestration ---
MCP_TOOL_TIMEOUT_SECONDS=120
ALARM_API_TIMEOUT_SECONDS=15
ALARM_API_MAX_RETRIES=2
LOG_LEVEL=INFO
HF_HUB_OFFLINE=1